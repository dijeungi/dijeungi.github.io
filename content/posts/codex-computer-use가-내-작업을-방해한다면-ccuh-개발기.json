                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "검증 환경:",
                    "marks": [
                      {
                        "type": "bold"
